{
    "$schema": "https://opencode.ai/config.json",
    "theme": "catpuccin",
    "lsp": true,
    "snapshot": false,
    "provider": {
        "local": {
            "name": "Local",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "gemma4:e4b": {
                    "name": "Gemma4 E4B"
                }
            }
        },
        "m33": {
            "name": "m.33",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://localhost:11001/v1"
            },
            "models": {
                "gpt-oss": {
                    "name": "GPT-OSS 120b"
                },
                "qwen3-coder-next": {
                    "name": "Qwen3 Coder Next"
                },
                "qwen3.6:35b": {
                    "name": "Qwen3.6 35B"
                },
                "qwen3.6:27b": {
                    "name": "Qwen3.6 27B"
                },
                "qwen3.6:35b-a3b": {
                    "name": "Qwen3.6 35B-A3B"
                }
            }
        }
    }
}
