export name = 'nickjvandyke/opencode.nvim'
export dependencies = 'folke/snacks.nvim'

{
  nvim_create_autocmd: autocmd,
  nvim_create_augroup: autogroup,
} = vim.api

export keys =
  * [1]: '<leader>cv'
    [2]: -> (require 'opencode').toggle!
    desc: 'Toggle opencode window'
    mode:
      * 'n'
      * 't'
  * [1]: '<leader>ca'
    [2]: -> (require 'opencode').ask '@this ', submit: true
    desc: 'Ask opencode...'
    mode:
      * 'n'
      * 'x'
  * [1]: '<leader>cx'
    [2]: -> (require 'opencode').select!
    desc: 'Select opencode...'
    mode:
      * 'n'
      * 'x'

export config = ->
  vim.o.autoread = true

  group = autogroup 'opencode_numbering', clear: true
  for event in *{ 'TermOpen', 'TermLeave' }
    autocmd event,
      :group
      pattern: '*opencode*'
      callback: ->
        with vim.opt_local
          .number = false
          .relativenumber = false
